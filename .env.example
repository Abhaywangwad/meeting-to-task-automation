# ---- MySQL (used by backend and docker-compose.yml) ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=meet2action
MYSQL_USER=meet2action_user
MYSQL_PASSWORD=your_local_password
MYSQL_ROOT_PASSWORD=your_root_password   # only used by docker-compose.yml

# ---- Backend (Spring Boot) ----
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JPA_DDL_AUTO=none            # schema comes from db/schema-mysql.sql; use "validate" to check entities vs schema
SCHEMA_INIT=true             # apply db/schema-mysql.sql at startup (skipped gracefully if MySQL is down)
AGENT_SERVICE_URL=http://localhost:8000
AGENT_CONNECT_TIMEOUT_SECONDS=5
AGENT_READ_TIMEOUT_SECONDS=60
MEETING_DEDUPE_WINDOW_SECONDS=30

# ---- Agent service (FastAPI) ----
AGENT_SERVICE_HOST=0.0.0.0
AGENT_SERVICE_PORT=8000
# OpenAI-compatible chat-completions provider (server-side only; belongs in agent-service/.env, never in frontend/.env
# or Spring Boot). Default setup: Google Gemini via its OpenAI-compatible endpoint. See agent-service/.env.example.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Must be a model ID available to the Google AI Studio project that owns the key.
LLM_MODEL=gemini-3.8-flash
LLM_TIMEOUT_SECONDS=30
# Set to false if your provider rejects response_format={"type":"json_object"}
LLM_JSON_MODE=true
# ---- Trello (BACKEND ONLY: set these in the shell that starts Spring Boot; never in frontend/.env or agent-service) ----
# All three are optional to start the app; without them "Sync to Trello" answers 503 trello_not_configured.
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_LIST_ID=
TRELLO_API_BASE_URL=https://api.trello.com/1
# TRELLO_CONNECT_TIMEOUT_SECONDS=5
# TRELLO_READ_TIMEOUT_SECONDS=15
# TRELLO_STALE_SYNC_SECONDS=120   # a SYNCING attempt older than this may be reconciled

# ---- Frontend (Vite) ----
# Public URLs only: VITE_* values are bundled into the browser app. Never put secrets here.
VITE_API_BASE_URL=http://localhost:8080
VITE_AGENT_BASE_URL=http://localhost:8000
