# Agent service settings (FastAPI). Copy this file to agent-service/.env (git-ignored) and fill in the key.
# The key belongs ONLY here: never in React/frontend files, Spring Boot, README, or tracked files.

# --- Google Gemini through its OpenAI-compatible endpoint ---
# Create a key in Google AI Studio (https://aistudio.google.com/apikey) and paste it below, locally only.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Must be a model ID available to the Google AI Studio project that owns the key; change it any time.
LLM_MODEL=gemini-3.8-flash
LLM_TIMEOUT_SECONDS=30
# Gemini supports response_format={"type":"json_object"}; set false only if the endpoint rejects it.
LLM_JSON_MODE=true

# Optional
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
